# =============================================================================
# Customer & User Service
# =============================================================================

# Full async database URL passed to SQLAlchemy.
# Format: postgresql+asyncpg://<user>:<password>@<host>/<dbname>
# The host must match the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://cus_user:cus_password@customer_user_db/cus_db

# PostgreSQL credentials — must match DATABASE_URL above.
CUSTOMER_USER_DB_NAME=cus_db
CUSTOMER_USER_DB_USER=cus_user
CUSTOMER_USER_DB_PASSWORD=cus_password


# =============================================================================
# Kafka
# =============================================================================

# Comma-separated list of Kafka broker addresses.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Consumer group ID used by the plan.confirmed consumer.
KAFKA_GROUP_ID=customer_user_service


# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://redis:6379/0


# =============================================================================
# Planning Service
# =============================================================================

# Full async database URL passed to SQLAlchemy.
# Format: postgresql+asyncpg://<user>:<password>@<host>/<dbname>
# The host must match the docker-compose service name.
PLANNING_DATABASE_URL=postgresql+asyncpg://planning_user:planning_password@planning_db:5432/planning_db

# PostgreSQL credentials — must match PLANNING_DATABASE_URL above.
PLANNING_DB_NAME=planning_db
PLANNING_DB_USER=planning_user
PLANNING_DB_PASSWORD=planning_password
