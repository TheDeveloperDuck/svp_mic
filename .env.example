# =============================================================================
# Customer & User Service
# =============================================================================

# Full async database URL passed to SQLAlchemy.
# Format: postgresql+asyncpg://<user>:<password>@<host>/<dbname>
# The host must match the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://cus_user:cus_password@customer_user_db/cus_db

# PostgreSQL credentials — must match DATABASE_URL above.
CUSTOMER_USER_DB_NAME=cus_db
CUSTOMER_USER_DB_USER=cus_user
CUSTOMER_USER_DB_PASSWORD=cus_password


# =============================================================================
# Kafka (uncomment when wiring messaging in step 6)
# =============================================================================

# KAFKA_BOOTSTRAP_SERVERS=kafka:9092


# =============================================================================
# Redis (uncomment when caching is implemented in step 2)
# =============================================================================

# REDIS_URL=redis://redis:6379/0
